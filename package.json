{
  "name": "divus-coaching",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "node scripts/phone.mjs",
    "phone": "node scripts/phone.mjs",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "node scripts/copy-wasm.mjs && expo export --platform web && node scripts/postbuild-web.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rls": "bash scripts/test-rls.sh",
    "check": "npm run typecheck && npm run lint && npm run core:check && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "db:types:test": "KEEP_DB=1 bash scripts/test-rls.sh && supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:54329/postgres --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "test:coverage": "jest --coverage",
    "core:sync": "node scripts/sync-core.mjs",
    "core:check": "node scripts/sync-core.mjs --check",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "barcode-detector": "^3.2.5",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-auth-session": "~58.0.18",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "i18next": "^27.1.3",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "qrcode-terminal": "^0.12.0",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-gifted-charts|gifted-charts-core)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/core/**/*.ts",
      "!src/core/testing/**",
      "!src/core/index.ts"
    ],
    "coverageThreshold": {
      "./src/core/": {
        "lines": 95,
        "functions": 95,
        "branches": 85
      }
    }
  }
}
