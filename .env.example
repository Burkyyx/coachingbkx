# ------------------------------------------------------------
# Variables d'environnement de l'application (copier en .env.local)
# ------------------------------------------------------------
# Seules les variables préfixées EXPO_PUBLIC_ sont incluses dans l'app.
# Elles sont PUBLIQUES par nature : n'y mets JAMAIS de clé secrète.

# URL et clé "anon" (publique) du projet Supabase.
# En local (après `npm run db:start`) :
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=colle-ici-la-cle-anon-affichee-par-supabase-start

# URL publique du site web (sert à fabriquer les liens d'invitation).
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Active ou non les boutons de connexion Google / Apple (true/false).
# Ils nécessitent une configuration côté Supabase (voir README).
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false

# ------------------------------------------------------------
# Secrets — NE PAS mettre dans .env.local de l'app.
# Ils vont dans les secrets Supabase (supabase secrets set ...) :
#   SUPABASE_SERVICE_ROLE_KEY   (fourni automatiquement aux Edge Functions)
#   EXPO_ACCESS_TOKEN           (optionnel, pour l'envoi des notifications push)
#   CRON_SECRET                 (protège les tâches planifiées)
# ------------------------------------------------------------
